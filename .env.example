# Planned integrations; none are needed to view the current UI preview.
# Fill these in one integration at a time. Never commit real values.

# Database: development PostgreSQL connection string from Tiger Data.
DATABASE_URL=

# Login: a random app secret, generated locally rather than obtained from a provider.
AUTH_SECRET=

# Google sign-in: OAuth client ID and client secret from your Google application.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook sign-in: application ID and secret, when this provider is implemented.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Quest generation: server-side Gemini API key.
GEMINI_API_KEY=

# Hardware reporting and hosting settings will be added once their setup is agreed.
# Do not put server credentials in NEXT_PUBLIC_ variables.
