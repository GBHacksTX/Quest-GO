# MVP integrations; none are needed to try the complete isolated demo.
# Fill these in one integration at a time. Never commit real values.

# Local MVP accounts use a separate persistent SQLite file; no database account is needed.
QUESTGO_STORAGE=sqlite
# Optional when QUESTGO_STORAGE=postgres. Existing datasets are not overwritten.
DATABASE_URL=
# Optional stable secret for demo cookies; normal account sessions need no key.
AUTH_SECRET=

# Meta AI: quest writing and photo checking, server-side only.
# Blank = two-player photo checks are simulated and labelled as such.
# (MODEL_API_KEY, the name in Meta's docs, also works.)
META_AI_API_KEY=
# Optional overrides; blank uses https://api.meta.ai/v1 and muse-spark-1.3.
META_AI_BASE_URL=
META_AI_MODEL=
META_AI_VISION_MODEL=

# Two players (Prabesh and Ramu). Username = board pairing code.
# Format code:Name:espDeviceId, where espDeviceId is the ESP server's device_id.
QUESTGO_PLAYERS_ENABLED=true
QUESTGO_PLAYERS=prabesh:Prabesh:1,ramu:Ramu:2

# Optional canonical app origin, e.g. https://questgo.example.com when hosted.
AUTH_URL=
# Disable the isolated demo on a live-only public deployment.
QUESTGO_DEMO_ENABLED=true
# Optional service overrides. Blank uses the documented public OSM endpoints.
QUESTGO_OVERPASS_URL=
QUESTGO_GEOCODER_URL=

# Devices have their own provisioned firmware keys; do not use server secrets on ESP32s.
# Do not put server credentials in NEXT_PUBLIC_ variables.

# Optional ESP test broadcasts. Events are read from the ESP server (http/ service) over HTTPS;
# no database connection is needed. The token is the ESP server's INGEST_TOKEN (server-side only).
PROXIMITY_API_URL=
PROXIMITY_API_TOKEN=
QUESTGO_NOTIFICATION_BROADCAST=false
# "Moved apart" / "out of range" must hold this long before it is announced.
QUESTGO_NOTIFICATION_SETTLE_SECONDS=20
# Generate once with npm run notifications:keys; keep keys stable across restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your real public HTTPS origin or mailto contact; not a localhost URL.
VAPID_SUBJECT=
