# MVP integrations; none are needed to try the complete isolated demo.
# Fill these in one integration at a time. Never commit real values.

# Local MVP accounts use a separate persistent SQLite file; no database account is needed.
QUESTGO_STORAGE=sqlite
# Optional when QUESTGO_STORAGE=postgres. Existing datasets are not overwritten.
DATABASE_URL=
# Stable random application secret, generated locally, not a paid API key.
AUTH_SECRET=

# Meta AI: quest writing and photo checking, server-side only.
META_AI_API_KEY=
# Optional overrides; blank uses https://api.meta.ai/v1 and muse-spark-1.3.
META_AI_BASE_URL=
META_AI_MODEL=
META_AI_VISION_MODEL=

# Optional canonical app origin, e.g. https://questgo.example.com when hosted.
AUTH_URL=
# Disable the isolated demo on a live-only public deployment.
QUESTGO_DEMO_ENABLED=true
# Optional service overrides. Blank uses the documented public OSM endpoints.
QUESTGO_OVERPASS_URL=
QUESTGO_GEOCODER_URL=

# Devices have their own provisioned firmware keys; do not use server secrets on ESP32s.
# Do not put server credentials in NEXT_PUBLIC_ variables.
